{
  "$defs": {
    "VerificationOutcome": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "UNCERTAIN"
      ],
      "title": "VerificationOutcome",
      "type": "string"
    }
  },
  "$id": "https://github.com/f0909172434/rigorgraph/schemas/verification-request.schema.json",
  "additionalProperties": false,
  "properties": {
    "checked_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Checked Evidence Ids",
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$",
      "title": "Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/VerificationOutcome"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "verifier": {
      "minLength": 1,
      "title": "Verifier",
      "type": "string"
    }
  },
  "required": [
    "id",
    "verifier",
    "outcome",
    "rationale"
  ],
  "title": "VerificationRequest",
  "type": "object"
}
